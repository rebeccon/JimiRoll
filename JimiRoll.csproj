<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================================
       JimiRoll —— 固定条件快速筛种
       ★ v2.0.0 起【不依赖任何第三方模组】（RolltheSpire2 已完全去掉）。
       纯代码 Mod：无 Godot、无 pck、不注册任何 UI。
       ============================================================ -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>13.0</LangVersion>
    <AssemblyName>JimiRoll</AssemblyName>
    <RootNamespace>JimiRoll</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>CS0168;CS0219;CS8600;CS8602;CS8603;CS8604;CS8618</NoWarn>
    <!--
      ★ 注意：这个路径只影响【编译】，不会进入 dll，也不影响【运行】。
        运行时那份写死的路径已经在 P0 里全部删掉了（GameInterop 从已加载程序集里取）。
        所以发布出去的包里不含任何盘符。

      换机器 / 换盘时，用环境变量覆盖即可，不用改文件：
        $env:STS2_GAME_DIR = "E:\Steam\steamapps\common\Slay the Spire 2"
    -->
    <GameDir Condition="'$(GameDir)' == '' AND '$(STS2_GAME_DIR)' != ''">$(STS2_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">D:\steam\steamapps\common\Slay the Spire 2</GameDir>
    <GameDataDir>$(GameDir)\data_sts2_windows_x86_64</GameDataDir>
    <ModsDir>$(GameDir)\mods\JimiRoll</ModsDir>

    <!--
      ★ 发布卫生：默认编译会把**本机源码绝对路径**写进 dll/pdb 的调试信息里
        （实测 dll 里能搜到 "C:\Users\<用户名>\Desktop\..."）。
        这里把仓库根目录映射成一个中性前缀，发布出去就看不到本机路径了。
    -->
    <PathMap>$(MSBuildProjectDirectory)=/JimiRoll</PathMap>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- 直接 HintPath 引用，不走 NuGet（沙箱无外网） -->
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 为了操作自定义开局的种子输入框（LineEdit）和系统剪贴板 -->
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ★ v2.0.0：RolltheSpire2 的引用已删除。
         骨骰判定现在是自研的（src/NeowPredict.cs），
         已与 RT2 在 10 万个种子上对拍一致率 100.0000%。 -->
  </ItemGroup>

  <!-- 编译后自动部署。加 -p:SkipDeploy=true 可只编译不部署。 -->
  <Target Name="DeployToMods" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <ItemGroup>
      <_OutFiles Include="$(TargetDir)$(AssemblyName).dll" />
      <_OutFiles Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
      <_Manifest Include="$(MSBuildProjectDirectory)\JimiRoll.json" />
      <_Extra Include="$(MSBuildProjectDirectory)\Pause.cmd" Condition="Exists('$(MSBuildProjectDirectory)\Pause.cmd')" />
      <_Extra Include="$(MSBuildProjectDirectory)\README.md" Condition="Exists('$(MSBuildProjectDirectory)\README.md')" />
      <_Extra Include="$(MSBuildProjectDirectory)\LICENSE" Condition="Exists('$(MSBuildProjectDirectory)\LICENSE')" />
    </ItemGroup>
    <ItemGroup>
      <_Docs Include="$(MSBuildProjectDirectory)\docs\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(ModsDir)" />
    <Copy SourceFiles="@(_OutFiles)" DestinationFolder="$(ModsDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(_Manifest)" DestinationFolder="$(ModsDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(_Extra)" DestinationFolder="$(ModsDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(_Docs)"
          DestinationFiles="@(_Docs->'$(ModsDir)\docs\%(RecursiveDir)%(Filename)%(Extension)')"
          ContinueOnError="true" />
    <Message Importance="high" Text="[JimiRoll] 已部署到 $(ModsDir)" />
  </Target>

</Project>
